# Dependencies / environments
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Environment secrets - never commit these
backend/.env
frontend/.env

# Build output
frontend/dist/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Uploaded/original attachments (placeholders are generated by create_sample_docs.py)
backend/uploads/*.pdf
!backend/uploads/.gitkeep
