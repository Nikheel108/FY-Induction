# ---------------------------------------------------------------------------
# Student Induction Management System - Backend environment configuration
#
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------------------------

# Flask secret key - used to sign admin tokens. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (local MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=induction_db
DB_USER=root
# Leave empty if your local MySQL root has no password.
DB_PASSWORD=

# Google Apps Script Web App URL for sending emails
GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Admin login credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
ADMIN_TOKEN_TTL_HOURS=12
